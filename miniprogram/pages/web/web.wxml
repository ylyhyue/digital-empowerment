<!-- pages/web/web.wxml —— 通用外链浏览器 -->
<web-view wx:if="{{src && !error}}" src="{{src}}" binderror="onError"></web-view>

<view wx:if="{{error}}" class="error-wrap">
  <view class="error-icon">🔗</view>
  <view class="error-title">无法直接打开</view>
  <view class="error-msg">{{errorMsg}}</view>
  <view class="error-url" wx:if="{{originalUrl}}">{{originalUrl}}</view>
  <view class="error-btns">
    <view class="btn primary" bindtap="copyLink">复制链接到浏览器打开</view>
    <view class="btn default" bindtap="goBack">返回上一页</view>
  </view>
</view>
