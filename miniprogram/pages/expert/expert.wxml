<!-- pages/expert/expert.wxml —— 专家陪跑团 -->
<view class="hero">
  <view class="h1">专家陪跑团</view>
  <view class="sub">由三位专家牵头组成的标准化博士团队，为企业和创业者提供陪跑服务。如需专家深度跟进，可在「我的」提交咨询或预约。</view>
</view>

<view class="ecard" wx:for="{{experts}}" wx:key="id">
  <view class="ava {{item.cls}}">{{item.avatar}}</view>
  <view class="info">
    <view class="nm">{{item.name}}</view>
    <view class="role">{{item.role}}</view>
    <view class="bio">{{item.bio}}</view>
    <view class="tags" wx:if="{{item.tags.length > 0}}">
      <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
    </view>
    <view class="bio tip" wx:else>资料待补充，请把该专家的姓名、职务与简介发我，我会简明扼要填入。</view>
  </view>
</view>
