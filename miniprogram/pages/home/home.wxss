/* pages/home/home.wxss */
.news { display: flex; gap: 16rpx; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f2f2f2; }
.news:active { opacity: .6; }
.news .dot { color: #07C160; font-size: 20rpx; margin-top: 8rpx; flex-shrink: 0; }
.news > view:nth-child(2) { flex: 1; min-width: 0; }
.news .nt { font-size: 26rpx; color: #333; line-height: 1.4; }
.news .nm { font-size: 22rpx; color: #bbb; margin-top: 6rpx; }
.news .arrow { color: #ccc; font-size: 32rpx; flex-shrink: 0; }
