<!-- pages/agentAdmin/agentAdmin.wxml -->
<view class="card">
  <view class="section-title"><view class="bar"></view>智博士团队连接权限</view>
  <view class="muted" style="font-size:24rpx;color:#888;line-height:1.6;">开启后，该博士团队才会显示在小程序「博士团队」页并可对话；关闭后将从小程序隐藏（H5 专属链接不受影响，仍独立可用）。</view>
</view>

<block wx:if="{{loading}}">
  <view class="loading">加载中…</view>
</block>

<block wx:elif="{{isAdmin}}">
  <view class="agent">
    <view class="ac"><view class="at">条码师培训团队</view><view class="ad">T/CABC 18.1 · 课件/题库/考证/UDI·DPP</view></view>
    <switch checked="{{agents[0].enabled}}" color="#07C160" bindchange="toggle" data-key="条码师培训 Bot"/>
  </view>
  <view class="agent">
    <view class="ac"><view class="at">营商数擎 DataBE</view><view class="ad">数据要素赋能营商环境 · 参赛/评审双模</view></view>
    <switch checked="{{agents[1].enabled}}" color="#07C160" bindchange="toggle" data-key="营商数擎 DataBE"/>
  </view>
  <view class="agent">
    <view class="ac"><view class="at">满意标尺 SatBE</view><view class="ad">企业满意看营商 · 参赛/评审双模</view></view>
    <switch checked="{{agents[2].enabled}}" color="#07C160" bindchange="toggle" data-key="满意标尺 SatBE"/>
  </view>
  <view class="agent">
    <view class="ac"><view class="at">创业问答团队</view><view class="ad">创业政策 / 标准化 / 条码 通用答疑</view></view>
    <switch checked="{{agents[3].enabled}}" color="#07C160" bindchange="toggle" data-key="创业问答 Bot"/>
  </view>
  <view class="tip">提示：关闭某博士团队后，小程序内即不可见；其 H5 专属链接仍可独立访问。</view>
</block>

<block wx:else>
  <view class="card perm">
    <view class="lock">🔒</view>
    <view class="pt">该页面仅管理员可操作</view>
    <view class="pm">{{claimed ? '管理员已被认领，请联系当前管理员' : '首次使用请先认领管理员权限'}}</view>
    <view wx:if="{{!claimed}}" class="claim" bindtap="claim">认领管理员权限</view>
  </view>
</block>
