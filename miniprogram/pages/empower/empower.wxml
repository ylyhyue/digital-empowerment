  <view class="muted" style="margin-bottom:16rpx;">（平顶山客货邮融合项目）</view>

  <view class="para">
    <text class="b">1个团队：</text>专家博士团队：
    <text class="link" bindtap="goLink" data-url="https://ylyhyue.github.io/team-profile">https://ylyhyue.github.io/team-profile</text>
