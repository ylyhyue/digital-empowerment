# 数字化赋能小程序 —— 云函数所需环境变量示例
# 生产：在微信云开发控制台为每个云函数设置「环境变量」
# 本地调试：将对应内容写入各云函数目录下的 secrets.local.js（gitignored）
# 注意：以下均为占位，请替换为真实值；任何真实密钥都不要提交进仓库

# ---- submitConsult 云函数（飞书 / 多维表格写咨询记录）----
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=YOUR_FEISHU_APP_SECRET
FEISHU_APP_TOKEN=YOUR_BITABLE_APP_TOKEN
FEISHU_TABLE_ID=tblXXXXXXXXXXXX

# ---- agentApi / agentChat 云函数（接 LLM）----
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_API_URL=https://api.deepseek.com/chat/completions
